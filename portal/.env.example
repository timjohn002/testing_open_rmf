# rmf-web api-server the portal talks to
RMF_API_URL=http://localhost:8000

# Auth towards the api-server: either a fixed token...
# RMF_API_TOKEN=
# ...or the JWT settings from the api-server's config (defaults shown:
# rmf-web default_config.py). CHANGE jwt_secret on both sides in production.
RMF_JWT_SECRET=rmfisawesome
RMF_JWT_ISS=stub
RMF_JWT_AUD=rmf_api_server
RMF_USER=admin

# Nav graphs to read place names and lanes from (':'-separated)
NAV_GRAPHS=../maps/site/nav_graph.yaml

# Fleets RMF can only watch/pause (Traffic Light, Read Only). Shown without
# commands. Comma separated.
MONITOR_ONLY_FLEETS=brand_c

# Operator login for the portal itself (HTTP basic). Leave empty only on a
# trusted network -- anyone who can open the page can move robots.
PORTAL_USER=operator
PORTAL_PASSWORD=change-me
PORTAL_HOST=127.0.0.1
PORTAL_PORT=8080
